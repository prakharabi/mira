# Copy to .env and fill in what you want. Everything here is optional --
# Mira runs fully locally without any of it.

# Cloud model. Any OpenAI-compatible endpoint works; Groq is the default
# because its free tier is fast enough to be useful.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Everything else -- Telegram bot token, Google OAuth client, n8n webhooks,
# Tavily -- is configured in the app's Settings, not here, so it can be
# changed without restarting the daemon.
